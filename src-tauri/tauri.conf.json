{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lander Lunar",
  "version": "1.0.1",
  "identifier": "io.github.luccabueno.landerlunar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lander Lunar",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0c0e17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Lucca Bueno Cuzzolin",
    "shortDescription": "Jogo de pouso, helicóptero e rover pelo Sistema Solar",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBM0YxNTQ3QjMxRUVCMjAKUldRZzZ4NnpSeFUvdWdEUWw4V0Z1UzJuMjdNc0FJZnVGaDR2dytnOTc0djg1cTBST0ZDZlpBRGoK",
      "endpoints": [
        "https://github.com/LuccaBueno/lander-lunar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}